{
  "name": "fnbr-api",
  "version": "1.0.0",
  "description": "Backend API for Fortnite Brasil Admin Dashboard",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "clean:api": "rimraf src/generated/v1",
    "pregenerate:api": "npm run clean:api",
    "openapi:bundle": "redocly bundle --config openapi/v1/redocly.yaml openapi/v1/openapi/index.yaml -o openapi/v1/openapi/dist/openapi.yaml",
    "openapi:lint": "redocly lint --config openapi/v1/redocly.yaml openapi/v1/openapi/index.yaml",
    "openapi:build": "npm run openapi:lint && npm run openapi:bundle",
    "generate:api": "npm run openapi:build && openapi-generator-cli generate -i openapi/v1/openapi/dist/openapi.yaml -g typescript --global-property models -o src/generated/v1",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pino": "^9.4.0",
    "pino-http": "^10.2.0",
    "redis": "^6.2.1"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.13.4",
    "@redocly/cli": "^2.57.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.23.1",
    "rimraf": "^5.0.10",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
